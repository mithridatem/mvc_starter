{
  "name": "training/mvc_starter_web",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "mithridatem/router": "^1.7.1",
    "mithridatem/validation": "^1.2.1",
    "mithridatem/autowiring": "^1.4.2",
    "vlucas/phpdotenv": "^5.7"
  },
  "suggest": {
    "ext-pdo_mysql": "Pour DATABASE_DRIVER=mysql (MySQL/MariaDB)",
    "ext-pdo_pgsql": "Pour DATABASE_DRIVER=pgsql (PostgreSQL)",
    "ext-pdo_sqlite": "Pour DATABASE_DRIVER=sqlite (SQLite)"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  }
}
